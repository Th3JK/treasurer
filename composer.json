{
    "name": "th3jk/treasurer",
    "description": "This is my package treasurer",
    "keywords": [
        "th3jk",
        "treasurer"
    ],
    "homepage": "https://github.com/th3jk/treasurer",
    "license": "MIT",
    "authors": [
        {
            "name": "th3jk",
            "email": "th3jk@proton.me",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "comgate/sdk": "^1.9",
        "gopay/payments-sdk-php": "^1.11",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/log": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/pagination": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.5",
        "spatie/ray": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "Th3JK\\Treasurer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Th3JK\\Treasurer\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
            "test-coverage": "vendor/bin/phpunit --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {

            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Th3JK\\Treasurer\\TreasurerServiceProvider"
            ],
            "aliases": {
                "Treasurer": "Th3JK\\Treasurer\\Facades\\Treasurer"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
